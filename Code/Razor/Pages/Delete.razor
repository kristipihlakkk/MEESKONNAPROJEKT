@page "/gymrooms/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Delete Room</h3>

@if (room is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Are you sure you want to delete this room?</p>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@room.Name</dd>

        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@room.Type</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@room.Capacity</dd>

    </dl>

    <button class="btn btn-danger" @onclick="DeleteRoom">Delete</button>
    <a href="/gymrooms" class="btn btn-secondary">Cancel</a>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Room? room;

    protected override async Task OnInitializedAsync()
    {
        room = await RoomsRepo.GetAsync(Id);
        if (room is null) Navigation.NavigateTo("/gymrooms");
    }

    private async Task DeleteRoom()
    {
        await RoomsRepo.DeleteAsync(Id);
        Navigation.NavigateTo("/gymrooms");
    }
}