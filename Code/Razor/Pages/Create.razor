@page "/gymrooms/create"
@using Gym.Data
@using Gym.Infra
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Create Room</h3>

<div class="mb-3">
    <label>Name</label>
    <input class="form-control" @bind="name" placeholder="e.g. Cardio Hall A" />
</div>
<div class="mb-3">
    <label>Room Type</label>
    <select class="form-control" @bind="type">
        @foreach (var t in Enum.GetValues<RoomType>())
        {
            <option value="@t">@t</option>
        }
    </select>
</div>
<div class="mb-3">
    <label>Capacity</label>
    <input type="number" class="form-control" @bind="capacity" />
</div>
<div class="mb-3">
    <label>Open From</label>
    <input type="time" class="form-control" @bind="openFrom" />
</div>
<div class="mb-3">
    <label>Open To</label>
    <input type="time" class="form-control" @bind="openTo" />
</div>
<div class="mb-3">
    <label>Description</label>
    <textarea class="form-control" @bind="description" rows="3"></textarea>
</div>

<button class="btn btn-success" @onclick="CreateRoom">Create</button>
<a href="/gymrooms" class="btn btn-secondary">Cancel</a>

@code {
    private string name = "";
    private RoomType type = RoomType.Other;
    private int capacity = 0;
    private TimeOnly openFrom = new TimeOnly(6, 0);
    private TimeOnly openTo = new TimeOnly(22, 0);
    private string description = "";

    private async Task CreateRoom()
    {
        var room = new Room
        {
            Name = name,
            Type = type,
            Capacity = capacity,
            Description = description
        };
        await RoomsRepo.CreateAsync(room);
        Navigation.NavigateTo("/gymrooms");
    }
}