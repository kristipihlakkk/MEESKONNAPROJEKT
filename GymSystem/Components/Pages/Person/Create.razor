@page "/persons/create"
@using Gym.Data
@using Gym.Infra
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Create Person</h3>

<EditForm Model="@person" OnValidSubmit="@CreatePerson">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="firstName">First Name</label>
        <InputText id="firstName" class="form-control" @bind-Value="person.FirstName" />
    </div>
    <div class="mb-3">
        <label for="lastName">Last Name</label>
        <InputText id="lastName" class="form-control" @bind-Value="person.LastName" />
    </div>
    <div class="mb-3">
        <label for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="person.Email" />
    </div>
    <div class="mb-3">
        <label for="birthDate">Birth Date</label>
        <InputDate id="birthDate" class="form-control" @bind-Value="person.BirthDate" />
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a href="/persons" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private Person person = new();

    private async Task CreatePerson()
    {
        await PersonsRepo.CreateAsync(person);
        Navigation.NavigateTo("/persons");
    }
}