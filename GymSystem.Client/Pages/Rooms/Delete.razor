@page "/rooms/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Delete Room</h3>

<p>Are you sure you want to delete this room?</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@room?.Name</dd>

    <dt class="col-sm-2">Type</dt>
    <dd class="col-sm-10">@room?.Type</dd>

    <dt class="col-sm-2">Capacity</dt>
    <dd class="col-sm-10">@room?.Capacity</dd>
</dl>

<button class="btn btn-danger" @onclick="DeleteRoom">Delete</button>
<a href="/rooms" class="btn btn-secondary">Cancel</a>

@code {
    [Parameter] public Guid Id { get; set; }
    private Room? room;

    protected override async Task OnInitializedAsync()
    {
        room = await RoomsRepo.GetAsync(Id);
        if (room == null) Navigation.NavigateTo("/rooms");
    }

    private async Task DeleteRoom()
    {
        if (room != null)
        {
            await RoomsRepo.DeleteAsync(room.Id);
            Navigation.NavigateTo("/rooms");
        }
    }
}
