@page "/rooms/create"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@using Microsoft.AspNetCore.Components.Forms
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Create Room</h3>

<EditForm Model="@room" OnValidSubmit="@CreateRoom" FormName="CreateRoom">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="room.Name" />
    </div>
    <div class="mb-3">
        <label>Type</label>
        <select class="form-control" @bind="room.Type">
            @foreach (var t in Enum.GetValues<RoomType>())
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Capacity</label>
        <InputNumber class="form-control" @bind-Value="room.Capacity" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputTextArea class="form-control" @bind-Value="room.Description" />
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a href="/rooms" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private Room room = new();

    private async Task CreateRoom()
    {
        await RoomsRepo.CreateAsync(room);
        Navigation.NavigateTo("/rooms");
    }
}
