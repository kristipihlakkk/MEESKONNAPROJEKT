@page "/rooms/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Edit Room</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (room is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="@room" OnValidSubmit="@UpdateRoom" FormName="EditRoom">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="room.Name" />
        </div>
        <div class="mb-3">
            <label>Type</label>
            <select class="form-control" @bind="room.Type">
                @foreach (var t in Enum.GetValues<RoomType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Capacity</label>
            <InputNumber class="form-control" @bind-Value="room.Capacity" />
        </div>
        <div class="mb-3">
            <label>Open From</label>
            <input type="time" class="form-control"
                   value="@openFrom"
                   @onchange="e => openFrom = e.Value?.ToString() ?? openFrom" />
        </div>
        <div class="mb-3">
            <label>Open To</label>
            <input type="time" class="form-control"
                   value="@openTo"
                   @onchange="e => openTo = e.Value?.ToString() ?? openTo" />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <InputTextArea class="form-control" @bind-Value="room.Description" rows="3" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/rooms" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Room? room;
    private string openFrom = "06:00";
    private string openTo = "22:00";
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        room = await RoomsRepo.GetAsync(Id);
        if (room is null) { Navigation.NavigateTo("/rooms"); return; }
        openFrom = room.OpenFrom.ToString("HH:mm");
        openTo = room.OpenTo.ToString("HH:mm");
    }

    private async Task UpdateRoom()
    {
        errorMessage = string.Empty;
        if (room!.Capacity <= 0) { errorMessage = "Capacity must be greater than 0."; return; }
        if (!TimeOnly.TryParse(openFrom, out var from) || !TimeOnly.TryParse(openTo, out var to))
        { errorMessage = "Invalid time format."; return; }
        if (to <= from) { errorMessage = "Closing time must be after opening time."; return; }

        room.OpenFrom = from;
        room.OpenTo = to;
        await RoomsRepo.UpdateAsync(room);
        Navigation.NavigateTo("/rooms");
    }
}