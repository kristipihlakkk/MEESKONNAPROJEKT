@page "/rooms/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@using Microsoft.AspNetCore.Components.Forms
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Edit Room</h3>

<EditForm Model="@room" OnValidSubmit="@UpdateRoom" FormName="editRoomForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="room.Name" />
    </div>
    <div class="mb-3">
        <label>Type</label>
        <select class="form-control" @bind="room.Type">
            @foreach (var t in Enum.GetValues<RoomType>())
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Capacity</label>
        <InputNumber class="form-control" @bind-Value="room.Capacity" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputTextArea class="form-control" @bind-Value="room.Description" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/rooms" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Room room = new();

    protected override async Task OnInitializedAsync()
    {
        room = await RoomsRepo.GetAsync(Id);
        if (room == null) Navigation.NavigateTo("/rooms");
    }

    private async Task UpdateRoom()
    {
        await RoomsRepo.UpdateAsync(room);
        Navigation.NavigateTo("/rooms");
    }
}
