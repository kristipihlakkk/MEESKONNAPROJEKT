@page "/bookings"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IBookingsRepo BookingsRepo
@inject NavigationManager Navigation

<h3>Bookings</h3>

<a href="/bookings/create" class="btn btn-primary mb-3">Create New</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Room</th>
            <th>Booked By</th>
            <th>Starts</th>
            <th>Ends</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in bookings) {
            <tr>
                <td>@b.BookingTitle</td>
                <td>@b.RoomBookings?.FirstOrDefault()?.Room?.Name</td>
                <td>@b.BookedBy?.FullName</td>
                <td>@b.StartsAt.ToString("g")</td>
                <td>@b.EndsAt.ToString("g")</td>
                <td>
                    <a href="/bookings/edit/@b.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a href="/bookings/delete/@b.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Booking> bookings = new();

    protected override async Task OnInitializedAsync() {
        bookings = (await BookingsRepo.GetAsync(new Query())).ToList();
    }
}
