@page "/bookings/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IBookingsRepo BookingsRepo
@inject NavigationManager Navigation

<h3>Delete Booking</h3>

<p>Are you sure you want to delete this booking?</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@booking?.BookingTitle</dd>

    <dt class="col-sm-2">Room</dt>
    <dd class="col-sm-10">@booking?.RoomBookings?.FirstOrDefault()?.Room?.Name</dd>

    <dt class="col-sm-2">Booked By</dt>
    <dd class="col-sm-10">@booking?.BookedBy?.FullName</dd>

    <dt class="col-sm-2">Starts</dt>
    <dd class="col-sm-10">@booking?.StartsAt.ToString()</dd>

    <dt class="col-sm-2">Ends</dt>
    <dd class="col-sm-10">@booking?.EndsAt.ToString()</dd>
</dl>

<button class="btn btn-danger" @onclick="DeleteBooking">Delete</button>
<a href="/bookings" class="btn btn-secondary">Cancel</a>

@code {
    [Parameter] public Guid Id { get; set; }
    private Booking? booking;

    protected override async Task OnInitializedAsync()
    {
        booking = await BookingsRepo.GetAsync(Id);
        if (booking == null) Navigation.NavigateTo("/bookings");
    }

    private async Task DeleteBooking()
    {
        if (booking != null)
        {
            await BookingsRepo.DeleteAsync(booking.Id);
            Navigation.NavigateTo("/bookings");
        }
    }
}
