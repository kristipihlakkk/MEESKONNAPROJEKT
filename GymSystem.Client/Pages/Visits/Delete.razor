@page "/visits/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject IVisitsRepo VisitsRepo
@inject NavigationManager Navigation

<h3>Delete Visit</h3>

@if (visit is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="alert alert-warning">Are you sure you want to delete this visit?</div>

    <dl class="row">
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@visit.VisitDate.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-2">Person</dt>
        <dd class="col-sm-10">@GetPersonName()</dd>
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@GetRoomName()</dd>
    </dl>

    <button class="btn btn-danger" @onclick="DeleteVisit">Delete</button>
    <a href="/visits" class="btn btn-secondary">Cancel</a>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Visit? visit;

    protected override async Task OnInitializedAsync()
    {
        visit = await VisitsRepo.GetAsync(Id);
        if (visit is null) Navigation.NavigateTo("/visits");
    }

    private string GetPersonName()
    {
        var parts = visit?.Notes?.Split('|') ?? Array.Empty<string>();
        return parts.Length > 1 ? parts[1] : "—";
    }

    private string GetRoomName()
    {
        var parts = visit?.Notes?.Split('|') ?? Array.Empty<string>();
        return parts.Length > 2 ? parts[2] : "—";
    }

    private async Task DeleteVisit()
    {
        await VisitsRepo.DeleteAsync(Id);
        Navigation.NavigateTo("/visits");
    }
}