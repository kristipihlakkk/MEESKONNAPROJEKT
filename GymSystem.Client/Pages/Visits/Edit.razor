@page "/visits/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject IVisitsRepo VisitsRepo
@inject IPersonsRepo PersonsRepo
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Edit Visit</h3>

@if (visit is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="@visit" OnValidSubmit="@UpdateVisit" FormName="EditVisit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Person</label>
            <select class="form-control" @bind="selectedPersonId">
                <option value="">— select person —</option>
                @foreach (var p in persons)
                {
                    <option value="@p.Id">@p.FirstName @p.LastName</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Room</label>
            <select class="form-control" @bind="selectedRoomId">
                <option value="">— select room —</option>
                @foreach (var r in rooms)
                {
                    <option value="@r.Id">@r.Name (@r.Type)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Visit Date</label>
            <input type="datetime-local" class="form-control"
                   value="@editDate"
                   @onchange="e => editDate = e.Value?.ToString() ?? editDate" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/visits" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Visit? visit;
    private List<Person> persons = new();
    private List<Room> rooms = new();
    private string selectedPersonId = "";
    private string selectedRoomId = "";
    private string editDate = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        visit = await VisitsRepo.GetAsync(Id);
        if (visit is null) { Navigation.NavigateTo("/visits"); return; }

        persons = (await PersonsRepo.GetAsync(new Query())).ToList();
        rooms = (await RoomsRepo.GetAsync(new Query())).ToList();

        editDate = visit.VisitDate.ToString("yyyy-MM-ddTHH:mm");

        var parts = visit.Notes?.Split('|') ?? Array.Empty<string>();
        if (parts.Length > 0) selectedPersonId = parts[0];
        if (parts.Length > 2)
        {
            var room = rooms.FirstOrDefault(r => r.Name == parts[2]);
            if (room is not null) selectedRoomId = room.Id.ToString();
        }
    }

    private async Task UpdateVisit()
    {
        var person = persons.FirstOrDefault(p => p.Id.ToString() == selectedPersonId);
        var room = rooms.FirstOrDefault(r => r.Id.ToString() == selectedRoomId);

        visit!.VisitDate = DateTime.Parse(editDate);
        visit.Notes = $"{person?.Id}|{person?.FirstName} {person?.LastName}|{room?.Name ?? "—"}";

        await VisitsRepo.UpdateAsync(visit);
        Navigation.NavigateTo("/visits");
    }
}