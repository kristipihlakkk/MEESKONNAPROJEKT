@page "/visits/edit/{id:guid}"
@using Gym.Data
@using Gym.Data.Membership
@using Gym.Infra
@inject IVisitsRepo VisitsRepo
@inject IPersonsRepo PersonsRepo
@inject IRoomsRepo RoomsRepo
@inject IMembershipsRepo MembershipsRepo
@inject NavigationManager Navigation

<h3>Edit Visit</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (visit is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="@visit" OnValidSubmit="@UpdateVisit" FormName="EditVisit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Person</label>
            <select class="form-control" value="@selectedPersonId" @onchange="OnPersonChanged">
                <option value="">-- Select person --</option>
                @foreach (var p in persons)
                {
                    <option value="@p.Id">@p.FirstName @p.LastName</option>
                }
            </select>
        </div>

        @if (membershipStatus is not null)
        {
            <div class="alert @(membershipOk ? "alert-success" : "alert-warning") mb-3">
                @membershipStatus
            </div>
        }

        <div class="mb-3">
            <label>Room (optional)</label>
            <select class="form-control" @bind="selectedRoomId">
                <option value="">-- Select room --</option>
                @foreach (var r in rooms)
                {
                    <option value="@r.Id">@r.Name (@r.Type)</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Visit Date & Time</label>
            <input type="datetime-local" class="form-control"
                   value="@editDate"
                   @onchange="e => editDate = e.Value?.ToString() ?? editDate" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/visits" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Visit? visit;
    private List<Person> persons = new();
    private List<Room> rooms = new();
    private List<Membership> memberships = new();
    private string selectedPersonId = "";
    private string selectedRoomId = "";
    private string editDate = string.Empty;
    private string? membershipStatus;
    private bool membershipOk = false;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        visit = await VisitsRepo.GetAsync(Id);
        if (visit is null) { Navigation.NavigateTo("/visits"); return; }

        persons = (await PersonsRepo.GetAsync(new Query())).ToList();
        rooms = (await RoomsRepo.GetAsync(new Query())).ToList();
        memberships = (await MembershipsRepo.GetAsync(new Query())).ToList();

        editDate = visit.VisitDate.ToString("yyyy-MM-ddTHH:mm");
        var parts = visit.Notes?.Split('|') ?? Array.Empty<string>();
        if (parts.Length > 0) selectedPersonId = parts[0];
        if (parts.Length > 2)
        {
            var room = rooms.FirstOrDefault(r => r.Name == parts[2]);
            if (room is not null) selectedRoomId = room.Id.ToString();
        }
        CheckMembership();
    }

    private void OnPersonChanged(ChangeEventArgs e)
    {
        selectedPersonId = e.Value?.ToString() ?? "";
        CheckMembership();
    }

    private void CheckMembership()
    {
        if (string.IsNullOrEmpty(selectedPersonId)) { membershipStatus = null; return; }
        var personId = Guid.Parse(selectedPersonId);
        var membership = memberships
            .Where(m => m.MemberId == personId)
            .OrderByDescending(m => m.EndDate)
            .FirstOrDefault();

        if (membership is null)
        {
            membershipStatus = "This person has no membership.";
            membershipOk = false;
        }
        else if (membership.IsActive())
        {
            membershipStatus = $"Active: {membership.MembershipType}, expires {membership.EndDate:dd.MM.yyyy}.";
            membershipOk = true;
        }
        else
        {
            membershipStatus = $"Membership expired on {membership.EndDate:dd.MM.yyyy}.";
            membershipOk = false;
        }
    }

    private async Task UpdateVisit()
    {
        errorMessage = "";

        if (!membershipOk)
        {
            errorMessage = "Cannot save — person has no active membership.";
            return;
        }
        if (DateTime.TryParse(editDate, out var visitDt) && visitDt > DateTime.Now)
        {
            errorMessage = "Cannot log a visit in the future.";
            return;
        }

        var person = persons.FirstOrDefault(p => p.Id.ToString() == selectedPersonId);
        var room = rooms.FirstOrDefault(r => r.Id.ToString() == selectedRoomId);

        visit!.VisitDate = visitDt;
        visit.Notes = $"{person?.Id}|{person?.FirstName} {person?.LastName}|{room?.Name ?? "—"}";

        await VisitsRepo.UpdateAsync(visit);
        Navigation.NavigateTo("/visits");
    }
}