@page "/trainers/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject ITrainersRepo TrainersRepo
@inject NavigationManager Navigation

<h3>Delete Trainer</h3>

@if (trainer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Are you sure you want to delete this trainer?</p>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@trainer.Person?.FirstName @trainer.Person?.LastName</dd>

        <dt class="col-sm-2">Specialisation</dt>
        <dd class="col-sm-10">@trainer.Specialisation</dd>

        <dt class="col-sm-2">Bio</dt>
        <dd class="col-sm-10">@(string.IsNullOrEmpty(trainer.Bio) ? "—" : trainer.Bio)</dd>
    </dl>

    <button class="btn btn-danger" @onclick="DeleteTrainer">Delete</button>
    <a href="/trainers" class="btn btn-secondary">Cancel</a>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Trainer? trainer;

    protected override async Task OnInitializedAsync()
    {
        trainer = await TrainersRepo.GetAsync(Id);
        if (trainer is null) Navigation.NavigateTo("/trainers");
    }

    private async Task DeleteTrainer()
    {
        await TrainersRepo.DeleteAsync(Id);
        Navigation.NavigateTo("/trainers");
    }
}