@page "/trainers/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject ITrainersRepo TrainersRepo
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Edit Trainer</h3>

@if (trainer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="@trainer" OnValidSubmit="@UpdateTrainer" FormName="EditTrainer">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Person</label>
            <select class="form-control" value="@selectedPersonId" @onchange="e => selectedPersonId = e.Value?.ToString() ?? string.Empty">
                <option value="">— select person —</option>
                @foreach (var p in persons)
                {
                    <option value="@p.Id">@p.FirstName @p.LastName</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Specialisation</label>
            <input class="form-control" @bind="trainer.Specialisation" />
        </div>
        <div class="mb-3">
            <label>Bio</label>
            <textarea class="form-control" @bind="trainer.Bio" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label>Start Date</label>
            <input type="date" class="form-control" @bind="trainer.StartDate" />
        </div>
        <div class="mb-3">
            <label>End Date</label>
            <input type="date" class="form-control" @bind="trainer.EndDate" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/trainers" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Trainer? trainer;
    private List<Gym.Data.Person> persons = new();
    private string selectedPersonId = "";

    protected override async Task OnInitializedAsync()
    {
        trainer = await TrainersRepo.GetAsync(Id);
        if (trainer is null) { Navigation.NavigateTo("/trainers"); return; }
        persons = (await PersonsRepo.GetAsync(new Query())).ToList();
        selectedPersonId = trainer.PersonId.ToString();
    }

    private async Task UpdateTrainer()
    {
        if (!string.IsNullOrEmpty(selectedPersonId))
            trainer!.PersonId = Guid.Parse(selectedPersonId);
        await TrainersRepo.UpdateAsync(trainer!);
        Navigation.NavigateTo("/trainers");
    }
}