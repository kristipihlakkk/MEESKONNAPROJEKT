@page "/persons/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Edit Person</h3>

<EditForm Model="@person" OnValidSubmit="@UpdatePerson" FormName="editPersonForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="firstName">First Name</label>
        <InputText id="firstName" class="form-control" @bind-Value="person.FirstName" />
    </div>
    <div class="mb-3">
        <label for="lastName">Last Name</label>
        <InputText id="lastName" class="form-control" @bind-Value="person.LastName" />
    </div>
    <div class="mb-3">
        <label for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="person.Email" />
    </div>
    <div class="mb-3">
        <label for="birthDate">Birth Date</label>
        <InputDate id="birthDate" class="form-control" @bind-Value="person.BirthDate" />
    </div>

    <h5 class="mt-4">Addresses</h5>
    @foreach (var a in person.Addresses)
    {
        <div class="card mb-2">
            <div class="card-body">
                <div class="mb-2">
                    <label>Address Line 1</label>
                    <input class="form-control" @bind="a.AddressLine1" />
                </div>
                <div class="mb-2">
                    <label>City</label>
                    <input class="form-control" @bind="a.City" />
                </div>
                <div class="mb-2">
                    <label>Country</label>
                    <input class="form-control" @bind="a.Country" />
                </div>
            </div>
        </div>
    }
    

    <h5 class="mt-4">Contact Methods</h5>
    @foreach (var c in person.ContactMethods)
    {
        <div class="card mb-2">
            <div class="card-body">
                <div class="mb-2">
                    <label>Type</label>
                    <select class="form-control" @bind="c.Type">
                        @foreach (var t in Enum.GetValues<ContactType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label>Value</label>
                    <input class="form-control" @bind="c.Value" />
                </div>
            </div>
        </div>
    }
    
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/persons" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Person person = new();
   
    

    protected override async Task OnInitializedAsync()
    {
        person = await PersonsRepo.GetAsync(Id);
        if (person == null) Navigation.NavigateTo("/persons");
    }

    private async Task UpdatePerson()
    {
        await PersonsRepo.UpdateAsync(person);
        Navigation.NavigateTo("/persons");
    }
}