@page "/gymrooms/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Edit Room</h3>

<EditForm Model="@room" OnValidSubmit="@UpdateRoom" FormName="EditRoom">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <input class="form-control" @bind="room.Name" />
    </div>
    <div class="mb-3">
        <label>Room Type</label>
        <select class="form-control" @bind="room.Type">
            @foreach (var t in Enum.GetValues<RoomType>())
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Capacity</label>
        <input type="number" class="form-control" @bind="room.Capacity" />
    </div>
    <div class="mb-3">
        <label>Open From</label>
        <input type="time" class="form-control" value="@openFrom"
               @onchange="e => openFrom = e.Value?.ToString() ?? openFrom" />
    </div>
    <div class="mb-3">
        <label>Open To</label>
        <input type="time" class="form-control" value="@openTo"
               @onchange="e => openTo = e.Value?.ToString() ?? openTo" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <textarea class="form-control" @bind="room.Description" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/gymrooms" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Room room = new();
    private string openFrom = "06:00";
    private string openTo = "22:00";

    protected override async Task OnInitializedAsync()
    {
        var loaded = await RoomsRepo.GetAsync(Id);
        if (loaded == null) Navigation.NavigateTo("/gymrooms");
        else
        {
            room = loaded;
            openFrom = room.OpenFrom.ToString("HH:mm");
            openTo = room.OpenTo.ToString("HH:mm");
        }
    }

    private async Task UpdateRoom()
    {
        room.OpenFrom = TimeOnly.Parse(openFrom);
        room.OpenTo = TimeOnly.Parse(openTo);
        await RoomsRepo.UpdateAsync(room);
        Navigation.NavigateTo("/gymrooms");
    }
}