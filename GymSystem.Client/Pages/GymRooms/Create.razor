@page "/gymrooms/create"
@using Gym.Data
@using Gym.Infra
@inject IRoomsRepo RoomsRepo
@inject NavigationManager Navigation

<h3>Create Room</h3>

<EditForm Model="@room" OnValidSubmit="@CreateRoom" FormName="CreateRoom">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <input class="form-control" @bind="newName" placeholder="e.g. Cardio Hall A" />
    </div>
    <div class="mb-3">
        <label>Room Type</label>
        <select class="form-control" @bind="newType">
            @foreach (var t in Enum.GetValues<RoomType>())
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Capacity</label>
        <input type="number" class="form-control" @bind="newCapacity" />
    </div>
    <div class="mb-3">
        <label>Open From</label>
        <input type="time" class="form-control" value="@newOpenFrom"
               @onchange="e => newOpenFrom = e.Value?.ToString() ?? newOpenFrom" />
    </div>
    <div class="mb-3">
        <label>Open To</label>
        <input type="time" class="form-control" value="@newOpenTo"
               @onchange="e => newOpenTo = e.Value?.ToString() ?? newOpenTo" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <textarea class="form-control" @bind="newDescription" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a href="/gymrooms" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private Room room = new();
    private string newName = string.Empty;
    private RoomType newType = RoomType.Other;
    private int newCapacity = 0;
    private string newOpenFrom = "06:00";
    private string newOpenTo = "22:00";
    private string newDescription = string.Empty;

    private async Task CreateRoom()
    {
        room.Name = newName;
        room.Type = newType;
        room.Capacity = newCapacity;
        room.OpenFrom = TimeOnly.Parse(newOpenFrom);
        room.OpenTo = TimeOnly.Parse(newOpenTo);
        room.Description = newDescription;
        await RoomsRepo.CreateAsync(room);
        Navigation.NavigateTo("/gymrooms");
    }
}