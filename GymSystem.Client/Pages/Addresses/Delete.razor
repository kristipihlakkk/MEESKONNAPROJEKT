@page "/addresses/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IAddressesRepo AddressesRepo
@inject NavigationManager Navigation

<h3>Delete Address</h3>

<p>Are you sure you want to delete this address?</p>

<dl class="row">
    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@address?.AddressLine1</dd>

    <dt class="col-sm-2">City</dt>
    <dd class="col-sm-10">@address?.City</dd>

    <dt class="col-sm-2">Country</dt>
    <dd class="col-sm-10">@address?.Country</dd>
</dl>

<button class="btn btn-danger" @onclick="DeleteAddress">Delete</button>
<a href="/addresses" class="btn btn-secondary">Cancel</a>

@code {
    [Parameter] public Guid Id { get; set; }
    private Address? address;

    protected override async Task OnInitializedAsync()
    {
        address = await AddressesRepo.GetAsync(Id);
        if (address == null) Navigation.NavigateTo("/addresses");
    }

    private async Task DeleteAddress()
    {
        if (address != null)
        {
            await AddressesRepo.DeleteAsync(address.Id);
            Navigation.NavigateTo("/addresses");
        }
    }
}
