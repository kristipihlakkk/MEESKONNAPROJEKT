@page "/addresses/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IAddressesRepo AddressesRepo
@inject NavigationManager Navigation

<h3>Edit Address</h3>

<EditForm Model="@address" OnValidSubmit="@UpdateAddress" FormName="editAddressForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Address Line 1</label>
        <InputText class="form-control" @bind-Value="address.AddressLine1" />
    </div>
    <div class="mb-3">
        <label>Address Line 2</label>
        <InputText class="form-control" @bind-Value="address.AddressLine2" />
    </div>
    <div class="mb-3">
        <label>City</label>
        <InputText class="form-control" @bind-Value="address.City" />
    </div>
    <div class="mb-3">
        <label>Postal Code</label>
        <InputText class="form-control" @bind-Value="address.PostalCode" />
    </div>
    <div class="mb-3">
        <label>Country</label>
        <InputText class="form-control" @bind-Value="address.Country" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/addresses" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Address address = new();

    protected override async Task OnInitializedAsync()
    {
        address = await AddressesRepo.GetAsync(Id);
        if (address == null) Navigation.NavigateTo("/addresses");
    }

    private async Task UpdateAddress()
    {
        await AddressesRepo.UpdateAsync(address);
        Navigation.NavigateTo("/addresses");
    }
}
