@page "/persons"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Persons</h3>

<a href="/persons/create" class="btn btn-primary mb-3">Create New</a>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Birth Date</th>
            <th>Addresses</th>
            <th>Contact Methods</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in persons)
        {
            <tr>
                <td>@person.FirstName</td>
                <td>@person.LastName</td>
                <td>@person.Email</td>
                <td>@(person.BirthDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                <td>
                    @if (person.Addresses != null && person.Addresses.Any())
                    {
                        @foreach (var a in person.Addresses)
                        {
                            <span class="badge bg-secondary me-1">@a.AddressLine1, @a.City</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    @if (person.ContactMethods != null && person.ContactMethods.Any())
                    {
                        @foreach (var c in person.ContactMethods)
                        {
                            <span class="badge bg-info me-1">@c.Type: @c.Value</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    <a href="/persons/edit/@person.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a href="/persons/delete/@person.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Person> persons = new();

    protected override async Task OnInitializedAsync()
    {
        persons = (await PersonsRepo.GetAsync(new Query())).ToList();
    }
}