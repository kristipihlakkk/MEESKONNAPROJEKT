@page "/persons"
@rendermode InteractiveServer
@using Gym.Data
@using Gym.Infra
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Persons</h3>

<a href="/persons/create" class="btn btn-primary mb-3">Create New</a>

<table class="table">
    <thead>
        <tr><th>First Name</th><th>Last Name</th><th>Email</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var person in persons)
        {
            <tr>
                <td>@person.FirstName</td>
                <td>@person.LastName</td>
                <td>@person.Email</td>
                <td>
                    <a href="/persons/edit/@person.Id">Edit</a> |
                    <a href="/persons/delete/@person.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Person> persons = new();

    protected override async Task OnInitializedAsync()
    {
        persons = (await PersonsRepo.GetAsync(new Query())).ToList();
    }
}