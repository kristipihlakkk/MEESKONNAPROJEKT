@page "/persons/delete/{id:guid}"
@rendermode InteractiveServer
@using Gym.Data
@using Gym.Infra
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Delete Person</h3>

<p>Are you sure you want to delete this person?</p>

<dl class="row">
    <dt class="col-sm-2">First Name</dt>
    <dd class="col-sm-10">@person?.FirstName</dd>

    <dt class="col-sm-2">Last Name</dt>
    <dd class="col-sm-10">@person?.LastName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@person?.Email</dd>
</dl>

<button class="btn btn-danger" @onclick="DeletePerson">Delete</button>
<a href="/persons" class="btn btn-secondary">Cancel</a>

@code {
    [Parameter] public Guid Id { get; set; }
    private Person? person;

    protected override async Task OnInitializedAsync()
    {
        person = await PersonsRepo.GetAsync(Id);
        if (person == null) Navigation.NavigateTo("/persons");
    }

    private async Task DeletePerson()
    {
        if (person != null)
        {
            await PersonsRepo.DeleteAsync(person.Id);
            Navigation.NavigateTo("/persons");
        }
    }
}