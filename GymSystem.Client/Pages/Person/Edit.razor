@page "/persons/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject IPersonsRepo PersonsRepo
@inject NavigationManager Navigation

<h3>Edit Person</h3>

<EditForm Model="@person" OnValidSubmit="@UpdatePerson" FormName="editPersonForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="firstName">First Name</label>
        <InputText id="firstName" class="form-control" @bind-Value="person.FirstName" />
    </div>
    <div class="mb-3">
        <label for="lastName">Last Name</label>
        <InputText id="lastName" class="form-control" @bind-Value="person.LastName" />
    </div>
    <div class="mb-3">
        <label for="email">Email</label>
        <InputText id="email" class="form-control" @bind-Value="person.Email" />
    </div>
    <div class="mb-3">
        <label for="birthDate">Birth Date</label>
        <InputDate id="birthDate" class="form-control" @bind-Value="person.BirthDate" />
    </div>

    <h5 class="mt-4">Addresses</h5>
    @foreach (var a in person.Addresses)
    {
        <div class="card mb-2">
            <div class="card-body">
                <p>@a.AddressLine1, @a.City, @a.Country</p>
                <button type="button" class="btn btn-danger btn-sm" @onclick="() => person.Addresses.Remove(a)">Delete</button>
            </div>
        </div>
    }
    <div class="card mb-3">
        <div class="card-body">
            <input class="form-control mb-2" @bind="newLine1" placeholder="Address Line 1" />
            <input class="form-control mb-2" @bind="newCity" placeholder="City" />
            <input class="form-control mb-2" @bind="newCountry" placeholder="Country" />
            <button type="button" class="btn btn-secondary btn-sm" @onclick="AddAddress">Add Address</button>
        </div>
    </div>

    <h5 class="mt-4">Contact Methods</h5>
    @foreach (var c in person.ContactMethods)
    {
        <div class="card mb-2">
            <div class="card-body">
                <p>@c.Type: @c.Value</p>
                <button type="button" class="btn btn-danger btn-sm" @onclick="() => person.ContactMethods.Remove(c)">Delete</button>
            </div>
        </div>
    }
    <div class="card mb-3">
        <div class="card-body">
            <select class="form-control mb-2" @bind="newContactType">
                @foreach (var t in Enum.GetValues<ContactType>())
                {
                    <option value="@t">@t</option>
                }
            </select>
            <input class="form-control mb-2" @bind="newContactValue" placeholder="+372 5555 1234" />
            <button type="button" class="btn btn-secondary btn-sm" @onclick="AddContact">Add Contact</button>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/persons" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Person person = new();
    private string newLine1 = string.Empty;
    private string newCity = string.Empty;
    private string newCountry = string.Empty;
    private ContactType newContactType = ContactType.Phone;
    private string newContactValue = string.Empty;

    private void AddAddress()
    {
        if (!string.IsNullOrEmpty(newLine1))
        {
            person.Addresses.Add(new Address { AddressLine1 = newLine1, City = newCity, Country = newCountry });
            newLine1 = newCity = newCountry = string.Empty;
        }
    }

    private void AddContact()
    {
        if (!string.IsNullOrEmpty(newContactValue))
        {
            person.ContactMethods.Add(new ContactMethod { Type = newContactType, Value = newContactValue });
            newContactValue = string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        person = await PersonsRepo.GetAsync(Id);
        if (person == null) Navigation.NavigateTo("/persons");
    }

    private async Task UpdatePerson()
    {
        await PersonsRepo.UpdateAsync(person);
        Navigation.NavigateTo("/persons");
    }
}