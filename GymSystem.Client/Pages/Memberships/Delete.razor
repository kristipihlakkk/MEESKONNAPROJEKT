@page "/memberships/delete/{id:guid}"
@using Gym.Data.Membership
@using Gym.Infra
@inject IMembershipsRepo MembershipsRepo
@inject NavigationManager Navigation

<h3>Delete Membership</h3>

<p>Are you sure you want to delete this membership?</p>

<dl class="row">
	<dt class="col-sm-2">Member Id</dt>
	<dd class="col-sm-10">@membership?.MemberId</dd>

	<dt class="col-sm-2">Type</dt>
	<dd class="col-sm-10">@membership?.MembershipType</dd>

	<dt class="col-sm-2">Start</dt>
	<dd class="col-sm-10">@membership?.StartDate.ToString("g")</dd>

	<dt class="col-sm-2">End</dt>
	<dd class="col-sm-10">@membership?.EndDate.ToString("g")</dd>
</dl>

<button class="btn btn-danger" @onclick="DeleteMembership">Delete</button>
<a href="/memberships" class="btn btn-secondary">Cancel</a>

@code {
	[Parameter] public Guid Id { get; set; }
	private Membership? membership;

	protected override async Task OnInitializedAsync()
	{
		membership = await MembershipsRepo.GetAsync(Id);
		if (membership == null) Navigation.NavigateTo("/memberships");
	}

	private async Task DeleteMembership()
	{
		if (membership != null)
		{
			await MembershipsRepo.DeleteAsync(membership.Id);
			Navigation.NavigateTo("/memberships");
		}
	}
}
