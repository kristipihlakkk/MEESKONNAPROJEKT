@page "/locations/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject ILocationsRepo LocationsRepo
@inject IAddressesRepo AddressesRepo
@inject IRoomsRepo RoomsRepo
@inject ILocationRoomsRepo LocationRoomsRepo
@inject NavigationManager Navigation

<h3>Edit Location</h3>

<EditForm Model="location" OnValidSubmit="UpdateLocation">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Address</label>
        <select class="form-control" @bind="selectedAddressIdString">
            <option value="">-- Select address --</option>
            @foreach (var a in addresses)
            {
                <option value="@a.Id">@a.AddressLine1, @a.City (@a.Country)</option>
            }
        </select>
        <div class="mt-2">
            <a href="/addresses/create" class="btn btn-sm btn-link">Create new address</a>
        </div>
    </div>

    <div class="mb-3">
        <label>Opening Hours</label>
        <InputText class="form-control" type="time" @bind-Value="openingHoursString" />
    </div>
    <div class="mb-3">
        <label>Closing Hours</label>
        <InputText class="form-control" type="time" @bind-Value="closingHoursString" />
    </div>
    <div class="mb-3">
        <label>Additional Info</label>
        <InputTextArea class="form-control" @bind-Value="location.AdditionalInfo" />
    </div>

    <div class="mb-3">
        <label>Rooms (select one or many)</label>
        @if (rooms != null && rooms.Any())
        {
            <div>
                @foreach (var r in rooms)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="room_@r.Id" checked="@selectedRoomIds.Contains(r.Id)" @onchange="@(_ => ToggleRoom(r.Id))" />
                        <label class="form-check-label" for="room_@r.Id">@r.Name (@r.Type)</label>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-muted">No rooms available.</div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/locations" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Location location = new();
    private List<Address> addresses = new();
    private List<Room> rooms = new();
    private string selectedAddressIdString = string.Empty;
    private string openingHoursString = "06:00";
    private string closingHoursString = "22:00";
    private HashSet<Guid> selectedRoomIds = new();

    protected override async Task OnInitializedAsync()
    {
        location = await LocationsRepo.GetAsync(Id);
        if (location == null) Navigation.NavigateTo("/locations");
        else
        {
            addresses = (await AddressesRepo.GetAsync(new Query())).ToList();
            rooms = (await RoomsRepo.GetAsync(new Query())).ToList();

            if (location.Address != null)
            {
                selectedAddressIdString = location.Address.Id.ToString();
            }
            // populate selectedRoomIds from already assigned rooms
            selectedRoomIds.Clear();
            if (location?.LocationRooms != null)
            {
                foreach (var lr in location.LocationRooms)
                {
                    if (lr.RoomId != null) selectedRoomIds.Add(lr.RoomId.Value);
                }
            }
            try {
                openingHoursString = location.OpeningHours.ToString("HH:mm");
                closingHoursString = location.ClosingHours.ToString("HH:mm");
            } catch { }
        }
    }

    private async Task UpdateLocation()
    {
        if (!string.IsNullOrEmpty(selectedAddressIdString) && Guid.TryParse(selectedAddressIdString, out var aid))
        {
            var a = await AddressesRepo.GetAsync(aid);
            if (a != null) location.Address = a;
        }
        else
        {
            // No address selected - clear association
            location.Address = null;
        }
        try {
            if (!string.IsNullOrWhiteSpace(openingHoursString)) location.OpeningHours = TimeOnly.Parse(openingHoursString);
            if (!string.IsNullOrWhiteSpace(closingHoursString)) location.ClosingHours = TimeOnly.Parse(closingHoursString);
        } catch { }
        // prevent EF change tracker from trying to process navigation entries
        // (LocationRooms may contain null or untracked Room references)
        location.LocationRooms = null;
        await LocationsRepo.UpdateAsync(location);

        // synchronize LocationRooms assignments
        var loc = await LocationsRepo.GetAsync(location.Id);
        var existingRoomIds = new HashSet<Guid>(loc?.LocationRooms?.Where(x => x.RoomId != null).Select(x => x.RoomId!.Value) ?? Enumerable.Empty<Guid>());

        // Add new assignments
        foreach (var rid in selectedRoomIds)
        {
            if (existingRoomIds.Contains(rid)) continue; // skip existing
            try {
                var newLr = new LocationRooms { LocationId = location.Id, RoomId = rid };
                await LocationRoomsRepo.CreateAsync(newLr);
            } catch (Exception ex) {
                Console.Error.WriteLine($"Failed to create LocationRooms for location {location.Id} room {rid}: {ex}");
            }
        }

        // Remove assignments that were unchecked
        if (loc?.LocationRooms != null)
        {
            var toRemove = loc.LocationRooms.Where(lr => lr.RoomId != null && !selectedRoomIds.Contains(lr.RoomId.Value)).ToList();
            foreach (var rem in toRemove)
            {
                try {
                    await LocationRoomsRepo.DeleteAsync(rem.Id);
                } catch (Exception ex) {
                    Console.Error.WriteLine($"Failed to remove LocationRooms {rem.Id} for location {location.Id}: {ex}");
                }
            }
        }

        Navigation.NavigateTo("/locations");
    }

    private void ToggleRoom(Guid id)
    {
        if (selectedRoomIds.Contains(id)) selectedRoomIds.Remove(id);
        else selectedRoomIds.Add(id);
    }
}
