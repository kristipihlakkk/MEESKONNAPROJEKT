@page "/locations/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@using Gym.Data.Locations
@inject ILocationsRepo LocationsRepo
@inject IAddressesRepo AddressesRepo
@inject NavigationManager Navigation

<h3>Edit Location</h3>

<EditForm Model="@location" OnValidSubmit="@UpdateLocation" FormName="editLocationForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Address</label>
        <select class="form-control" @bind="selectedAddressIdString">
            <option value="">-- Select address --</option>
            @foreach (var a in addresses)
            {
                <option value="@a.Id">@a.AddressLine1, @a.City (@a.Country)</option>
            }
        </select>
        <div class="mt-2">
            <a href="/addresses/create" class="btn btn-sm btn-link">Create new address</a>
        </div>
    </div>

    <div class="mb-3">
        <label>Opening Hours</label>
        <InputText class="form-control" type="time" @bind-Value="openingHoursString" />
    </div>
    <div class="mb-3">
        <label>Closing Hours</label>
        <InputText class="form-control" type="time" @bind-Value="closingHoursString" />
    </div>
    <div class="mb-3">
        <label>Additional Info</label>
        <InputTextArea class="form-control" @bind-Value="location.AdditionalInfo" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/locations" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Location location = new();
    private List<Address> addresses = new();
    private string selectedAddressIdString = string.Empty;
    private string openingHoursString = "06:00";
    private string closingHoursString = "22:00";

    protected override async Task OnInitializedAsync()
    {
        location = await LocationsRepo.GetAsync(Id);
        if (location == null) Navigation.NavigateTo("/locations");
        else
        {
            addresses = (await AddressesRepo.GetAsync(new Query())).ToList();
            if (location.Address != null)
            {
                selectedAddressIdString = location.Address.Id.ToString();
            }
            try {
                openingHoursString = location.OpeningHours.ToString("HH:mm");
                closingHoursString = location.ClosingHours.ToString("HH:mm");
            } catch { }
        }
    }

    private async Task UpdateLocation()
    {
        if (!string.IsNullOrEmpty(selectedAddressIdString) && Guid.TryParse(selectedAddressIdString, out var aid))
        {
            var a = await AddressesRepo.GetAsync(aid);
            if (a != null) location.Address = a;
        }
        else
        {
            // No address selected - clear association
            location.Address = null;
        }
        try {
            if (!string.IsNullOrWhiteSpace(openingHoursString)) location.OpeningHours = TimeOnly.Parse(openingHoursString);
            if (!string.IsNullOrWhiteSpace(closingHoursString)) location.ClosingHours = TimeOnly.Parse(closingHoursString);
        } catch { }
        await LocationsRepo.UpdateAsync(location);
        Navigation.NavigateTo("/locations");
    }
}
