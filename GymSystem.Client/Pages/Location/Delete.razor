@page "/locations/delete/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject ILocationsRepo LocationsRepo
@inject NavigationManager Navigation

<h3>Delete Location</h3>

<p>Are you sure you want to delete this location?</p>

<dl class="row">
    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@location?.Address?.AddressLine1</dd>

    <dt class="col-sm-2">City</dt>
    <dd class="col-sm-10">@location?.Address?.City</dd>

    <dt class="col-sm-2">Country</dt>
    <dd class="col-sm-10">@location?.Address?.Country</dd>
</dl>

<button class="btn btn-danger" @onclick="DeleteLocation">Delete</button>
<a href="/locations" class="btn btn-secondary">Cancel</a>

@code {
    [Parameter] public Guid Id { get; set; }
    private Location? location;

    protected override async Task OnInitializedAsync()
    {
        location = await LocationsRepo.GetAsync(Id);
        if (location == null) Navigation.NavigateTo("/locations");
    }

    private async Task DeleteLocation()
    {
        if (location != null)
        {
            await LocationsRepo.DeleteAsync(location.Id);
            Navigation.NavigateTo("/locations");
        }
    }
}