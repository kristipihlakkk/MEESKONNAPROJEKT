@page "/locations/create"
@using Gym.Data
@using Gym.Infra
@inject ILocationsRepo LocationsRepo
@inject NavigationManager Navigation

<h3>Create Location</h3>

<EditForm Model="@location" OnValidSubmit="@CreateLocation" FormName="CreateLocation">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h5>Address</h5>
    <div class="mb-3">
        <label>Address Line 1</label>
        <input class="form-control" @bind="newLine1" placeholder="e.g. Tartu mnt 1" />
    </div>
    <div class="mb-3">
        <label>Address Line 2</label>
        <input class="form-control" @bind="newLine2" placeholder="optional" />
    </div>
    <div class="mb-3">
        <label>City</label>
        <input class="form-control" @bind="newCity" placeholder="e.g. Tallinn" />
    </div>
    <div class="mb-3">
        <label>Postal Code</label>
        <input class="form-control" @bind="newPostal" placeholder="optional" />
    </div>
    <div class="mb-3">
        <label>Country</label>
        <input class="form-control" @bind="newCountry" placeholder="e.g. Estonia" />
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a href="/locations" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private Location location = new();
    private string newLine1 = string.Empty;
    private string newLine2 = string.Empty;
    private string newCity = string.Empty;
    private string newPostal = string.Empty;
    private string newCountry = string.Empty;

    private async Task CreateLocation()
    {
        if (string.IsNullOrEmpty(newLine1) || string.IsNullOrEmpty(newCity) || string.IsNullOrEmpty(newCountry))
            return;

        location.Address = new Address
        {
            AddressLine1 = newLine1,
            AddressLine2 = newLine2,
            City = newCity,
            PostalCode = newPostal,
            Country = newCountry
        };
        await LocationsRepo.CreateAsync(location);
        Navigation.NavigateTo("/locations");
    }
}