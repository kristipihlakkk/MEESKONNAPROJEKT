@page "/locations/edit/{id:guid}"
@using Gym.Data
@using Gym.Infra
@inject ILocationsRepo LocationsRepo
@inject NavigationManager Navigation

<h3>Edit Location</h3>

<EditForm Model="@location" OnValidSubmit="@UpdateLocation" FormName="EditLocation">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <h5>Address</h5>
    <div class="mb-3">
        <label>Address Line 1</label>
        <input class="form-control" @bind="location.Address.AddressLine1" />
    </div>
    <div class="mb-3">
        <label>Address Line 2</label>
        <input class="form-control" @bind="location.Address.AddressLine2" />
    </div>
    <div class="mb-3">
        <label>City</label>
        <input class="form-control" @bind="location.Address.City" />
    </div>
    <div class="mb-3">
        <label>Postal Code</label>
        <input class="form-control" @bind="location.Address.PostalCode" />
    </div>
    <div class="mb-3">
        <label>Country</label>
        <input class="form-control" @bind="location.Address.Country" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/locations" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    private Location location = new() { Address = new Address() };

    protected override async Task OnInitializedAsync()
    {
        var loaded = await LocationsRepo.GetAsync(Id);
        if (loaded == null) Navigation.NavigateTo("/locations");
        else location = loaded;
    }

    private async Task UpdateLocation()
    {
        await LocationsRepo.UpdateAsync(location);
        Navigation.NavigateTo("/locations");
    }
}