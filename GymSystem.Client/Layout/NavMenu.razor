@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🏋️ Gym Management</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <MyNavLink Href="" Match="NavLinkMatch.All" IconClass="" Text="🏠 Home" />
        <MyNavLink Href="persons" IconClass="" Text="👤 Persons" />
        <MyNavLink Href="trainers" IconClass="" Text="🏋️ Trainers" />
        <MyNavLink Href="memberships" IconClass="" Text="💳 Memberships" />
        <MyNavLink Href="locations" IconClass="" Text="📍 Locations" />
        <MyNavLink Href="addresses" IconClass="" Text="🗺️ Addresses" />
        <MyNavLink Href="rooms" IconClass="" Text="🚪 Gym Rooms" />
        <MyNavLink Href="bookings" IconClass="" Text="📅 Bookings" />
        <MyNavLink Href="visits" IconClass="" Text="✅ Visits" />
    </nav>
</div>

@code {
    private string currentUrl = "";

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}